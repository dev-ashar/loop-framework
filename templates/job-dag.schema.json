{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs"],
  "properties": {
    "schemaVersion": {"const": 2},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "profile", "modelTier", "dependsOn", "writeScope", "verify", "lenses"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "role": {"enum": ["architect", "worker", "reviewer", "merge", "explorer"]},
          "profile": {"type": "string"},
          "modelTier": {"type": "string"},
          "dependsOn": {"type": "array", "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
          "writeScope": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
          "verify": {"type": "string", "minLength": 1, "maxLength": 1024},
          "lenses": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "worker"}}},
            "then": {"properties": {"writeScope": {"minItems": 1}, "lenses": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"role": {"const": "reviewer"}}},
            "then": {"properties": {"lenses": {"minItems": 1}}}
          }
        ]
      }
    }
  }
}
