{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobs": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "profile", "modelTier", "dependsOn", "writeScope", "verify", "lenses"],
        "properties": {
          "id": {"type":"string", "pattern":"^[a-z][a-z0-9-]{0,62}$"},
          "role": {"const":"builder"}, "profile":{"type":"string"}, "modelTier":{"type":"string"},
          "dependsOn":{"type":"array","maxItems":15,"uniqueItems":true,"items":{"type":"string"}},
          "writeScope":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string"}},
          "verify":{"type":"string","minLength":1,"maxLength":1024},
          "lenses":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string"}}
        }
      }
    }
  }
}
