# Isolated LOOPS provider configuration for can1357/oh-my-pi.
# HAIP credentials stay in the environment and never enter this repository.
providers:
  haip:
    baseUrl: __HAIP_BASE_URL__/v1
    api: anthropic-messages
    apiKey: __HAIP_TOKEN_ENV__
    authHeader: true
    models:
      - id: claude-opus-5-5
        name: LOOPS HAIP orchestrator
        contextWindow: 1000000
        maxTokens: 32000
      - id: claude-sonnet-5-5
        name: LOOPS HAIP architect worker
        contextWindow: 1000000
        maxTokens: 32000
      - id: gpt-6-luna
        name: LOOPS HAIP explorer
        contextWindow: 1000000
        maxTokens: 32000
      - id: gpt-6.1-sol
        name: LOOPS HAIP reviewer merge
        contextWindow: 1000000
        maxTokens: 32000
