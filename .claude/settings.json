{
  "model": "claude-opus-5",
  "effortLevel": "medium",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-mem.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-mem.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(loops status:*)",
      "Bash(loops lint:*)",
      "Bash(loops log:*)",
      "Bash(loops score:*)",
      "Bash(loops init:*)",
      "Bash(loops reap:*)",
      "Bash(loops multireport:*)",
      "Bash(loops scope-check:*)",
      "Bash(loops lesson:*)",
      "Bash(loops models list:*)",
      "Bash(loops models available:*)",
      "Bash(loops mem show:*)",
      "Bash(loops mem path:*)",
      "Bash(loops mem fact:*)",
      "Bash(loops mem note:*)",
      "Bash(loops session show:*)",
      "Bash(loops engine show:*)",
      "Bash(loops worktree check:*)"
    ]
  }
}
